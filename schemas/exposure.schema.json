{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonwitness/exposure.schema.json",
  "title": "MoonWitness Exposure",
  "type": "object",
  "required": ["id", "title", "event", "status"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "event": { "type": "string" },
    "witness": { "type": ["string", "null"] },
    "message": { "type": ["string", "null"] },
    "fault_line": { "type": ["string", "null"] },
    "what_is_exposed": { "type": ["string", "null"] },
    "what_remains_unknown": { "type": ["string", "null"] },
    "status": { "type": "string" }
  },
  "additionalProperties": true
}
