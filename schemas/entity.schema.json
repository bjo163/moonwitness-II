{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonwitness/entity.schema.json",
  "title": "MoonWitness Entity",
  "type": "object",
  "required": ["id", "type", "name", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "type": {
      "type": "string",
      "enum": [
        "person",
        "character",
        "alias",
        "symbol",
        "group",
        "fictional_reference",
        "public_reference",
        "composite",
        "unknown"
      ]
    },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "era": { "type": ["string", "null"] },
    "role": { "type": "array", "items": { "type": "string" } },
    "description": { "type": ["string", "null"] },
    "source": { "type": ["string", "null"] },
    "provenance": { "type": ["string", "null"] },
    "canon_level": {
      "type": "string",
      "enum": ["canon", "lore", "interpretation", "unknown"]
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "unlisted", "archived", "private"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "published", "archived", "forgotten", "reopened", "unknown", "unresolved", "promoted"]
    }
  },
  "additionalProperties": true
}