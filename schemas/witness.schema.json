{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonwitness/witness.schema.json",
  "title": "MoonWitness Witness Log",
  "type": "object",
  "required": ["id", "event", "witnessed_by", "status"],
  "properties": {
    "id": { "type": "string" },
    "date_time": { "type": ["string", "null"] },
    "era": { "type": ["string", "null"] },
    "event": { "type": "string" },
    "witnessed_by": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "signal": { "type": ["string", "null"] },
    "observation": { "type": ["string", "null"] },
    "message": { "type": ["string", "null"] },
    "seduction": { "type": ["string", "null"] },
    "fault_lines": { "type": "array", "items": { "type": "string" } },
    "exposure": { "type": ["string", "null"] },
    "past_presence": { "type": ["string", "null"] },
    "conflict": { "type": ["string", "null"] },
    "sanity_last_breath": { "type": ["string", "null"] },
    "interpretation": { "type": ["string", "null"] },
    "audit": { "type": ["string", "null"] },
    "evaluation": { "type": ["string", "null"] },
    "balancing": { "type": ["string", "null"] },
    "promoting": { "type": ["string", "null"] },
    "change": { "type": ["string", "null"] },
    "next_phase": { "type": ["string", "null"] },
    "source": { "type": ["string", "null"] },
    "provenance": { "type": ["string", "null"] },
    "status": { "type": "string" }
  },
  "additionalProperties": true
}