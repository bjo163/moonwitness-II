{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonwitness/seduction.schema.json",
  "title": "MoonWitness Seduction",
  "type": "object",
  "required": ["id", "title", "type", "event", "status"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "event": { "type": "string" },
    "flow": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string" }
  },
  "additionalProperties": true
}
